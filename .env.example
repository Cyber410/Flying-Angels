# Copy to .env for local Docker and fill the required database/Admin values.
MYSQL_DATABASE=flying_angels
MYSQL_USER=appuser
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
APP_ADMIN_EMAIL=
# At least 12 characters; used only to create the first persisted Admin account.
APP_ADMIN_PASSWORD=
# After backing up and reviewing an existing unversioned schema, enable baselining for one startup only.
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
SPRING_FLYWAY_BASELINE_VERSION=1
# Highest migration packaged in this backend image; lowering this does not undo changes.
SPRING_FLYWAY_TARGET=latest
# Login failures share database counters across backend instances; successful login clears the account count.
APP_LOGIN_THROTTLE_ENABLED=true
APP_LOGIN_THROTTLE_ACCOUNT_LIMIT=5
APP_LOGIN_THROTTLE_IP_LIMIT=100
APP_LOGIN_THROTTLE_WINDOW_SECONDS=900
APP_LOGIN_THROTTLE_BLOCK_SECONDS=900
# Empty trusts no forwarding headers. Use only the immediate Nginx proxy IP/CIDR when backend access is restricted.
APP_LOGIN_TRUSTED_PROXIES=
# Optional comma-separated browser origins for direct cross-origin API access.
# Leave empty when /api is accessed through the same-origin Vite/Nginx proxy.
APP_CORS_ALLOWED_ORIGINS=
BACKEND_HTTP_PORT=8080
# Optional invitation email. Local capture: docker compose --profile mail up --build mysql backend mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@flyingangels.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
APP_ACTIVATION_URL=http://localhost:5173/activate
APP_INVITATION_HOURS=48
# Generate once with: openssl rand -base64 32. Keep private and retain across backend restarts.
APP_MAIL_OUTBOX_KEY=
APP_MAIL_OUTBOX_ENABLED=true
APP_MAIL_OUTBOX_POLL_MS=5000
APP_MAIL_OUTBOX_BATCH_SIZE=20
APP_MAIL_OUTBOX_MAX_ATTEMPTS=5
APP_MAIL_OUTBOX_RETRY_BASE_SECONDS=60
APP_MAIL_OUTBOX_RETRY_MAX_SECONDS=3600
APP_MAIL_OUTBOX_LEASE_SECONDS=120
APP_AVAILABILITY_TIME_ZONE=America/Toronto
# Club-supplied inclusive bands: label:minAge:maxAge;label:minAge:maxAge. Empty means unconfigured.
APP_AGE_GROUP_BANDS=
