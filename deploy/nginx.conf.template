# The startup script defines trusted_edge_proxy using the original socket peer.
# Accept a single protocol value from a trusted ALB; ignore direct-client claims.
map "$trusted_edge_proxy:$http_x_forwarded_proto" $client_scheme {
    default $scheme;
    "1:https" https;
    "1:http" http;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 12m;
    server_tokens off;
    absolute_redirect off;

    location = /api {
        return 308 /api/;
    }

    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        # real_ip resolves ALB-appended XFF only when its socket peer is trusted.
        # Pass one resolved address, never a client-controlled chain, to Spring.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $client_scheme;
        proxy_set_header Forwarded "";
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
