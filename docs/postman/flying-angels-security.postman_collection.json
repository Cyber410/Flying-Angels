{
  "info": {
    "name": "Flying Angels - Secure mode checks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run only when app.security.require-authentication=true. Set local username/password environment values for the bootstrap ADMIN. Cookies must remain enabled. No credentials are stored in this collection. VIEWER/COACH roles need separately provisioned test identities; see ProductionSecurityTest for automated role checks."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Anonymous read is rejected",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/athletes",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid credentials are rejected",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/athletes",
        "header": [],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "invalid-postman-user",
              "type": "string"
            },
            {
              "key": "password",
              "value": "invalid-postman-password",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin reads and obtains CSRF token",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/csrf",
        "header": [],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "var responseBody=pm.response.json(); pm.test(\"CSRF token present\",()=>pm.expect(responseBody.token).to.be.a(\"string\").and.not.empty); pm.collectionVariables.set(\"csrfToken\",responseBody.token); pm.collectionVariables.set(\"csrfHeader\",responseBody.headerName);"
            ]
          }
        }
      ]
    },
    {
      "name": "Basic credentials without CSRF are rejected",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/athletes",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"PostmanSecurity\",\n  \"lastName\": \"QA {{$guid}}\",\n  \"gender\": \"Female\",\n  \"dateOfBirth\": null,\n  \"events\": []\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Basic credentials with invalid CSRF are rejected",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/athletes",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "{{csrfHeader}}",
            "value": "invalid-token"
          }
        ],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"PostmanSecurity\",\n  \"lastName\": \"QA {{$guid}}\",\n  \"gender\": \"Female\",\n  \"dateOfBirth\": null,\n  \"events\": []\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Authenticated write with CSRF succeeds",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/athletes",
        "header": [
          {
            "key": "{{csrfHeader}}",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"PostmanSecurity\",\n  \"lastName\": \"QA {{$guid}}\",\n  \"gender\": \"Female\",\n  \"dateOfBirth\": null,\n  \"events\": []\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"securityAthleteId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete created security-test athlete",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/athletes/{{securityAthleteId}}",
        "header": [
          {
            "key": "{{csrfHeader}}",
            "value": "{{csrfToken}}"
          }
        ],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirm deleted athlete is absent",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/athletes/{{securityAthleteId}}",
        "header": [],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
